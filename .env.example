# ─────────────────────────────────────────────────────────────────────────────
# Firebase — Client SDK (public, safe to expose via NEXT_PUBLIC_)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Firebase — Admin SDK (server-only, never prefix with NEXT_PUBLIC_)
# ─────────────────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Local (.env.local): use \n escape sequences — Next.js processes them automatically.
# Netlify dashboard: paste the raw PEM with REAL line breaks (copy from service account JSON).
FIREBASE_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
# Set to your deployed domain in production (e.g. https://rcrm.excelbees.com.au)
NEXT_PUBLIC_APP_URL=https://your-domain.com
# dev | prd | maintenance — keep both vars set to the SAME value in every
# environment. "dev" noindexes the site and shows a beta banner. "maintenance"
# keeps the site indexable/functional but disables login/signup. Client
# components need the NEXT_PUBLIC_ mirror since they can't read the plain var.
APP_ENVIRONMENT=prd
NEXT_PUBLIC_APP_ENVIRONMENT=prd

# ─────────────────────────────────────────────────────────────────────────────
# Email — SMTP
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_EMAIL_NAME=
# Inbox that receives public contact form submissions (/api/contact)
CONTACT_FORM_TO=

# ─────────────────────────────────────────────────────────────────────────────
# Admin
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# AI — Gemini (server-only — NEVER use NEXT_PUBLIC_ prefix)
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Upstash Redis (rate limiting)
# ─────────────────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Secrets
# ─────────────────────────────────────────────────────────────────────────────
# Protects /api/admin/sync-claims — generate a strong random value:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SYNC_SECRET=

# AES-256-GCM key for encrypting stored SMTP passwords in Firestore.
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: Never change after first deployment — changing it breaks all stored SMTP configs.
ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Logging (optional overrides — see docs/LOGGING.md)
# ─────────────────────────────────────────────────────────────────────────────
# Server log level: debug | info | warn | error  (default: info in production)
# LOG_LEVEL=info
# Client console log level: debug | info | warn | error  (default: warn in production)
# NEXT_PUBLIC_LOG_LEVEL=warn
