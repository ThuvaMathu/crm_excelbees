# App
NEXT_PUBLIC_APP_URL=https://your-domain.com
IS_PRODUCTION=true

# Logging (see docs/LOGGING.md)
# Server log level: debug | info | warn | error.
# Default: debug in development, info in production.
# LOG_LEVEL=info
# Client console log level: debug | info | warn | error.
# Default: debug in development, warn in production.
# NEXT_PUBLIC_LOG_LEVEL=warn

# Gemini AI (Server-only — never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_EMAIL_NAME=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secrets
ADMIN_SYNC_SECRET=
CRON_SECRET=
