rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      // In a real app, you'd check a custom claim or a user role document
      // For now, we'll assume any authenticated user can act as an 'admin' 
      // of their own data, but you might want to restrict this further.
      return isAuthenticated(); 
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Leads
    match /leads/{leadId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || resource.data.ownerId == null);
    }

    // Contacts
    match /contacts/{contactId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || resource.data.ownerId == null);
    }

    // Companies
    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || resource.data.ownerId == null);
    }

    // Deals
    match /deals/{dealId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || resource.data.ownerId == null);
    }

    // Projects
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || resource.data.ownerId == null);
    }

    // Tasks
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || resource.data.assigneeId == request.auth.uid || resource.data.ownerId == null);
    }

    // Invoices
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || resource.data.ownerId == null);
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Allow functions or backend triggers to write (in client-side logic we might need this if we create notifs from client)
      // Actually strictly, notifications should probably be created by Cloud Functions, 
      // but our current architecture creates them from the client side calls in lib/firestore/*.ts
      allow create: if isAuthenticated(); 
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid; // Read/Delete
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Activities
    match /activities/{activityId} {
       allow read: if isAuthenticated();
       allow create: if isAuthenticated();
    }
  }
}
