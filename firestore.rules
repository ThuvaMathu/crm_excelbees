rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================================
    // HELPER FUNCTIONS
    // ============================================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // User Data Helpers
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Check if user is approved AND active (new field)
    function isApproved() {
      return isAuthenticated() && 
             getUserData().isApproved == true &&
             getUserData().isActive != false; // Default to true if missing
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }
    
    function isManager() {
      return isAuthenticated() && (getUserData().role == 'manager' || getUserData().role == 'admin');
    }

    // ============================================================================
    // USERS COLLECTION (Admin-Only User Creation System)
    // ============================================================================
    
    match /users/{userId} {
      // Read: Users can read their own profile. Admins/Managers can read all.
      allow read: if isOwner(userId) || isManager();
      
      // Create: ONLY ADMINS can create users (no public registration)
      // Exception: Allow self-creation during migration/first login if doc doesn't exist
      allow create: if isAdmin() || (
        isOwner(userId) && 
        !exists(/databases/$(database)/documents/users/$(userId))
      );
      
      // Update: 
      // - Users can update their own non-critical fields (displayName, photoURL, settings, etc.)
      // - Users CANNOT change: role, isApproved, isActive, createdBy
      // - Users CAN change: isFirstLogin (when changing password)
      // - Admins can update any field
      allow update: if 
        (isOwner(userId) && (
          // Users can update non-sensitive fields
          !request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasAny(['role', 'isApproved', 'isActive', 'createdBy']) ||
          // Users can update isFirstLogin when changing password
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isFirstLogin', 'passwordChangedAt', 'updatedAt', 'lastLoginAt']) &&
           request.resource.data.isFirstLogin == false)
        )) ||
        isManager(); // Admins/Managers can update any user
      
      // Delete: Only admins can delete users
      allow delete: if isAdmin();
    }

    // ============================================================================
    // DEFAULT PROTECTION REMOVED
    // The previous catch-all rule allowed any approved user to read/write ANY collection.
    // This is insecure for HR/Payroll data.
    // All collections must be explicitly defined below.
    // ============================================================================
    
    // match /{collection}/{docId} {
    //   allow read, write: if isAuthenticated() && isApproved();
    // }
    
    // ============================================================================
    // SPECIFIC COLLECTION RULES
    // ============================================================================
    
    match /leads/{leadId} {
      allow read, write: if isAuthenticated() && isApproved();
    }
    
    match /contacts/{contactId} {
      allow read, write: if isAuthenticated() && isApproved();
    }
    
    match /companies/{companyId} {
      allow read, write: if isAuthenticated() && isApproved();
    }
    
    match /deals/{dealId} {
      allow read, write: if isAuthenticated() && isApproved();
    }
    
    match /projects/{projectId} {
      allow read, write: if isAuthenticated() && isApproved();
    }
    
    match /tasks/{taskId} {
      allow read, write: if isAuthenticated() && isApproved();
    }

    match /email_templates/{templateId} {
      allow read: if isAuthenticated() && isApproved();
      allow write: if isAuthenticated() && isApproved(); 
    }
    
    match /invoices/{invoiceId} {
      allow read, write: if isAuthenticated() && isApproved();
    }

    // ============================================================================
    // MARKETING AI - CALENDAR COLLECTIONS
    // ============================================================================
    
    // Calendar collections - user-specific data
    match /marketing/calendar/users/{userId}/calendars/{calendarId} {
      allow read, write: if isOwner(userId) && isApproved();
    }
    
    match /marketing/calendar/users/{userId}/plans/{planId} {
      allow read, write: if isOwner(userId) && isApproved();
    }
    
    // Calendar templates - read by all, write by owner
    match /marketing/calendar/templates/{templateId} {
      allow read: if isAuthenticated() && isApproved();
      allow create: if isAuthenticated() && isApproved() && 
                      request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isApproved() && 
                              resource.data.userId == request.auth.uid;
    }
    
    // Marketing AI - Blog Writer collections (existing)
    match /marketing/blog-writer/users/{userId}/blogs/{blogId} {
      allow read, write: if isOwner(userId) && isApproved();
    }
    // ============================================================================
    // HR / EMPLOYEE MANAGEMENT (Strict RBAC)
    // ============================================================================

    match /employees/{employeeId} {
      // Read: Users can see themselves. Managers/Admins can see all.
      allow read: if isOwner(employeeId) || isManager();
      // Write: Only Admins can modify employee profiles.
      allow write: if isAdmin();
    }

    match /attendance/{attendanceId} {
      // Read: Enable if user owns the record or if manager
      allow read: if (resource == null && request.auth.uid != null) || 
                   isOwner(resource.data.userId) || isManager();
                   
      // Create: Users can clock in (userId must match auth)
      allow create: if isOwner(request.resource.data.userId);
      
      // Update: Users can clock out. Managers can edit.
      allow update: if isOwner(resource.data.userId) || isManager();
    }

    match /leaves/{leaveId} {
      allow read: if (resource == null && request.auth.uid != null) || 
                   isOwner(resource.data.userId) || isManager();
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId) || isManager();
    }

    match /payroll/{payrollId} {
      // Only owner can read their own payroll. Admin can write.
      allow read: if isOwner(resource.data.userId);
      allow write: if isAdmin();
    }

  }
}
