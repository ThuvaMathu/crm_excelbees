rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // HELPER FUNCTIONS
    // ============================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Admins and managers are always considered approved.
    // Regular users need isApproved == true AND isActive != false.
    function isApproved() {
      let data = getUserData();
      return isAuthenticated() && (
        data.role == 'admin' ||
        data.role == 'manager' ||
        (data.isApproved == true && data.isActive != false)
      );
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isManager() {
      return isAuthenticated() && (getUserData().role == 'manager' || getUserData().role == 'admin');
    }

    function isTeamMember() {
      return isAuthenticated() && getUserData().role == 'team';
    }

    function isTaskOwner(taskData) {
      return isAuthenticated() && request.auth.uid == taskData.createdBy;
    }

    function isProjectOwner(projectData) {
      return isAuthenticated() && request.auth.uid == projectData.createdBy;
    }

    // ============================================================================
    // USERS COLLECTION
    // ============================================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isManager();

      // New users can self-create with role='team' only (no privilege escalation).
      // Admins can create any user document.
      allow create: if isAdmin() || (
        isOwner(userId) &&
        !exists(/databases/$(database)/documents/users/$(userId)) &&
        request.resource.data.role == 'team'
      );

      // Admins: full update on any user document.
      // Managers: update ONLY team members' non-sensitive fields (NOT role, isActive, etc.).
      //           Cannot modify admin or manager documents at all.
      // Owners: update own non-sensitive fields only.
      // Special: owner flips isFirstLogin → false on first password change.
      allow update: if
        isAdmin() ||
        (isManager() &&
          isOwner(userId) == false &&
          resource.data.role == 'team' &&
          !request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasAny(['role', 'isApproved', 'isActive', 'permissions', 'createdBy'])) ||
        (isOwner(userId) &&
          !request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasAny(['role', 'isApproved', 'isActive', 'permissions', 'createdBy'])) ||
        (isOwner(userId) &&
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['isFirstLogin', 'passwordChangedAt', 'updatedAt', 'lastLoginAt']) &&
          request.resource.data.isFirstLogin == false);

      allow delete: if isAdmin();
    }

    // ============================================================================
    // CRM CORE COLLECTIONS
    // All require an approved, active user (admins/managers bypass isApproved check).
    // ============================================================================

    match /leads/{leadId} {
      allow read, write: if isApproved();
    }

    match /contacts/{contactId} {
      allow read, write: if isApproved();
    }

    match /companies/{companyId} {
      allow read, write: if isApproved();
    }

    match /deals/{dealId} {
      allow read, write: if isApproved();
    }

    match /invoices/{invoiceId} {
      allow read, write: if isApproved();
    }

    // ============================================================================
    // ACTIVITIES (notes, calls, meetings logged against leads/contacts/deals)
    // Collection name used in code: "activities"
    // ============================================================================

    match /activities/{activityId} {
      allow read: if isApproved();
      allow create: if isApproved();
      allow update: if isApproved() && (isAdmin() || isManager() || resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin() || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    // ============================================================================
    // EMAILS (sent/received emails logged in CRM)
    // Collection name used in code: "emails"
    // ============================================================================

    match /emails/{emailId} {
      allow read: if isApproved();
      allow create: if isApproved();
      allow update: if isApproved() && (isAdmin() || isManager() || resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (isApproved() && resource.data.userId == request.auth.uid);
    }

    // ============================================================================
    // EMAIL TEMPLATES
    // IMPORTANT: collection name in code is "emailTemplates" (camelCase)
    // ============================================================================

    match /emailTemplates/{templateId} {
      allow read: if isApproved();
      allow write: if isApproved();
    }

    // ============================================================================
    // PROJECTS & TASKS (role-based create/update/delete)
    // ============================================================================

    match /projects/{projectId} {
      allow read: if isApproved();
      // Admin or non-manager/non-team users (i.e. regular creators) can create
      allow create: if isApproved() && (isAdmin() || (isManager() == false && isTeamMember() == false));
      // Admin, Manager, or the project creator can update
      allow update: if isApproved() && (isAdmin() || isManager() || isProjectOwner(resource.data));
      // Only Admin or creator can delete
      allow delete: if isApproved() && (isAdmin() || isProjectOwner(resource.data));
    }

    match /tasks/{taskId} {
      allow read: if isApproved();
      // Admin or non-manager/non-team users can create
      allow create: if isApproved() && (isAdmin() || (isManager() == false && isTeamMember() == false));
      // Admin, Manager, or the task creator can update
      allow update: if isApproved() && (isAdmin() || isManager() || isTaskOwner(resource.data));
      // Only Admin or creator can delete
      allow delete: if isApproved() && (isAdmin() || isTaskOwner(resource.data));
    }

    // ============================================================================
    // NOTIFICATIONS
    // ============================================================================

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow create: if isApproved();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ============================================================================
    // AUDIT LOGS
    // Collection name used in code: "audit_logs"
    // Only admins can read. Approved users can create (system writes on actions).
    // No one can update or delete audit logs (immutable record).
    // ============================================================================

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isApproved();
      allow update, delete: if false;
    }

  }
}
